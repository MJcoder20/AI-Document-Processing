APP_NAME=AI Document Processing Platform
# Production requires APP_ENV=production and DEBUG=false.
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Authentication
# Production: generate a unique random secret of at least 32 characters.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
DOCUMENT_STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_processing

# CORS
# Production example: ["https://your-frontend-domain.com"]
CORS_ORIGINS=["http://localhost:5173"]

# AI extraction
AI_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Background processing
PROCESSING_MODE=inline
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=document-processing
SERVICE_BUS_MAX_DELIVERY_COUNT=5

# Security
# Production example: api.your-domain.com
ALLOWED_HOSTS=api.example.com
