
APP_NAME=AI Document Processing Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Storage
DOCUMENT_STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=10

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_processing

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# AI extraction
AI_PROVIDER=ollama

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Background processing
PROCESSING_MODE=inline
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_QUEUE_NAME=document-processing
SERVICE_BUS_MAX_DELIVERY_COUNT=5
